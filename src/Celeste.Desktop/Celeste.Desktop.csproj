<Project Sdk="Microsoft.NET.Sdk">
	<!-- Development host (M1): runs the patched Celeste on Linux, with the same flow as the Android app. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>linux-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<RootNamespace>CelesteAndroid.Desktop</RootNamespace>
		<AssemblyName>CelesteDesktop</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<!-- Port option definitions and the JSON reader/writer (shared with the patches and the Android app). -->
		<Compile Include="..\Celeste.Android.Patches\PortSettingsCatalog.cs" Link="PortSettingsCatalog.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
		<ProjectReference Include="..\Steamworks.NET\Steamworks.NET.csproj" />
		<ProjectReference Include="..\Celeste.Patcher\Celeste.Patcher.csproj" />
		<ProjectReference Include="..\Celeste.Android.Patches\Celeste.Android.Patches.csproj"
			ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<!-- fnalibs linux-x64 (SDL3, FNA3D, FAudio; scripts/fetch-fnalibs.sh) -->
		<None Include="$(RepoRoot)natives\linux-x64\*.so*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<!-- The game's FMOD 1.10 (Celeste/lib64, versioned .so.10): P/Invoke looks for libfmod.so / libfmodstudio.so. -->
		<None Include="$(CelesteGameDir)lib64\libfmod.so.10" Link="libfmod.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="$(CelesteGameDir)lib64\libfmodstudio.so.10" Link="libfmodstudio.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<!-- libfmodstudio.so depends on libfmod.so.10 (soname): it also ships under the versioned name. -->
		<None Include="$(CelesteGameDir)lib64\libfmod.so.10" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<!-- MonoMod module: types/patches from here are merged into Celeste.dll by Celeste.Patcher. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Celeste.Android.mm</AssemblyName>
		<RootNamespace>CelesteAndroid</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- MonoMod patterns: extern orig_*, ignored fields and null in signatures copied from the game. -->
		<NoWarn>$(NoWarn);CS0626;CS0414;CS8625</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MonoMod.Patcher" Version="25.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Celeste">
			<HintPath>$(CelesteGameDir)Celeste.exe</HintPath>
			<Private>false</Private>
		</Reference>
		<ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" Private="false" />
	</ItemGroup>
</Project>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Tweaks to the generated bindings of SDL3's Java: protected fields whose type is a
     package-private class cannot be exposed in C#, and we do not need them. -->
<metadata>
	<remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLActivity']/field[@name='mClipboardHandler']" />
	<remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLActivity']/field[@name='mMotionListener']" />
	<remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLControllerManager']/field[@name='mHapticHandler']" />
	<remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLControllerManager']/field[@name='mJoystickHandler']" />
</metadata>

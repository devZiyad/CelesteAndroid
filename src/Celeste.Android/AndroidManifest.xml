<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-feature android:glEsVersion="0x00030000" android:required="true" />
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />
	<uses-feature android:name="android.hardware.gamepad" android:required="false" />
	<uses-feature android:name="android.software.leanback" android:required="false" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- Só para instalar o jogo pela Steam; depois de instalado o jogo roda totalmente offline. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- O botão "Abrir no app da Steam" precisa enxergar o app (visibilidade de pacotes, Android 11+). -->
	<queries>
		<package android:name="com.valvesoftware.android.steam.community" />
	</queries>
	<application android:icon="@mipmap/app_icon" android:roundIcon="@mipmap/app_icon"
		android:theme="@style/Theme.Celeste" android:hasCode="true" android:isGame="true"
		android:appCategory="game" android:allowBackup="true" />
</manifest>

<Project Sdk="Microsoft.NET.Sdk">
	<!-- Installing the game from Steam (SteamKit2): login, manifest, resumable chunked download.
	     No Android dependency: the pure logic (file selection, leftover removal, resume) is tested with dotnet test on Linux. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>CelesteAndroid.Steam</RootNamespace>
		<AssemblyName>Celeste.Steam</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="SteamKit2" Version="3.5.0" />
	</ItemGroup>
</Project>
